# InferForge configuration template — copy to .env and fill in.
# Loaded at import time by app.py (web) and celery_app.py (worker);
# variables already exported in the shell (start.sh / docker compose
# environment blocks) take precedence over this file.

# --- VLM tasks (worker reads these; required for /predict/vlm/* and /predict/agent/*) ---
INFERFORGE_LLM_MODEL=
INFERFORGE_LLM_API_KEY=
# INFERFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
# INFERFORGE_LLM_PROMPT=

# --- Agent tasks (optional; server-side instructions for /predict/agent/*) ---
# INFERFORGE_AGENT_INSTRUCTIONS=

# --- deployment shape switches ---
# INFERFORGE_ASYNC=1
# INFERFORGE_LLM=1
# INFERFORGE_AGENT=1

# --- sync capability switches (off by default; detection is always on) ---
# INFERFORGE_SEG=1
# INFERFORGE_SEG_MODEL_PATH=
# INFERFORGE_CLS=1
# INFERFORGE_CLS_MODEL_PATH=

# --- model registry (see docs/model-registry.md) ---
# Multi-model routing reads models/registry.yaml; when that file is absent
# the *_MODEL_PATH vars below synthesize a single-model registry. If the
# file exists it is the sole source of truth and these vars are ignored.
# INFERFORGE_REGISTRY_PATH=

# --- optional capabilities ---
# INFERFORGE_API_KEY=
# INFERFORGE_RATE_LIMIT=60
# INFERFORGE_MODEL_PATH=
# INFERFORGE_PRELOAD=1
#   Load each enabled capability's DEFAULT model at startup (per process:
#   gunicorn worker / celery worker child). /health/ready becomes 200
#   immediately; without it, the first request pays the load latency and
#   readiness is 503 until then. Best-effort — a broken model is logged
#   and that capability stays not-ready.
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# INFERFORGE_REDIS_URL=redis://localhost:6379/0
# INFERFORGE_RESULT_TTL=3600
